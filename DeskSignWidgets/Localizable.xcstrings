        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "滑到小组件页面，然后按住一个小组件叠放。"
          }
        }
      }
    },
    "Tap + and choose Desk Sign. Pick a size and add it." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点 +，选择「工位指示牌」，挑一个尺寸并添加。"
          }
        }
      }
    },
    "Turn off Smart Rotate for that stack (or remove the other widgets) so the sign stays on screen." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为这个叠放关闭「智能轮换」（或移除其他小组件），状态牌就会一直显示。"
          }
        }
      }
