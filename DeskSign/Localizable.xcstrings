      }
    },
    "Stand iPhone Duo in tent mode and StandBy shows your sign in LED letters. It follows the status you pick here; tap it to switch." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把 iPhone Duo 立成帐篷模式，待机显示就会用 LED 点阵字显示你的状态牌。它跟随你在这里选的状态；轻点即可切换。"
